# ==============================================================================
# Bug_SaaS Autonomous Platform Environment Configuration
# ==============================================================================

# 1. OpenRouter API Key (Get a free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Best Free OpenRouter AI Models:
# Agent 1 (Validate & Summarize): meta-llama/llama-3.3-70b-instruct:free or google/gemini-2.0-flash-lite-preview-02-05:free
AGENT1_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Agent 2 (Generate Patch & Rank): qwen/qwen-2.5-coder-32b-instruct:free or meta-llama/llama-3.3-70b-instruct:free
AGENT2_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# 2. GitHub Personal Access Token (PAT)
# Create a PAT with 'repo' write scope at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Target Customer Repository on GitHub to push automated fixes to
GITHUB_OWNER=
GITHUB_REPO=Test
GITHUB_BRANCH=main

# Set to true to push automated commits directly to GitHub via API
ENABLE_GITHUB_PUSH=true

# 3. SaaS Server Configuration
PORT=4000
SITE_TOKEN=site-token-taskflow-demo

# Force mock mode even if OPENROUTER_API_KEY is present (useful for offline testing)
FORCE_MOCK=false

# 4. Database Configuration (sqlite | firestore)
# Set to 'firestore' to enable Cloud Firestore database storage
DB_DRIVER=sqlite

# Firebase Cloud Firestore Credentials (Required if DB_DRIVER=firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

